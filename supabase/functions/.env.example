# Sao chép thành supabase/functions/.env (không commit). Trên cloud dùng `supabase secrets set`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:titan-push@example.com
TITAN_AI_MODEL=claude-haiku-5-5
ANTHROPIC_API_KEY=
# Thông báo hẹn giờ + đọc Gmail mỗi phút (pg_cron gửi kèm header x-cron-secret)
CRON_SECRET=
# V13-12 · Đọc biên lai VCB qua Gmail API: OAuth client giống đăng nhập Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Khóa mã hóa refresh token Gmail: openssl rand -base64 32
GMAIL_TOKEN_KEY=
